# Скопируйте в .env и заполните

DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=symposium.kaznu.kz
DJANGO_CSRF_TRUSTED_ORIGINS=https://symposium.kaznu.kz
# если фронт живёт на другом домене:
# CORS_ALLOWED_ORIGINS=https://site.example.kz

FRONTEND_URL=https://symposium.kaznu.kz

# PostgreSQL (без этих строк используется SQLite)
# DB_ENGINE=postgres
# DB_NAME=afgs
# DB_USER=afgs
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Почта (SMTP-сервер)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.kz
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Al-Farabi Symposium <al-farabi@kaznu.kz>

# Предохранитель: тестовую оплату нельзя включить из админки, пока здесь false
PAYMENTS_TEST_MODE=false

# --- Начальные значения. После первого запуска всё ниже меняется в админке
#     («Настройки симпозиума»), правка .env на них больше не влияет. ---
ORGANIZERS_EMAILS=al-farabi@kaznu.kz
PAYMENT_PROVIDERS=manual
PAYABLE_PAPER_STATUSES=accepted
BANK_RECIPIENT=НАО «Казахский национальный университет имени аль-Фараби»
BANK_BIN=
BANK_IIK=
BANK_NAME=
BANK_BIK=
BANK_KBE=
BANK_KNP=

REQUIRE_VERIFIED_EMAIL=true
